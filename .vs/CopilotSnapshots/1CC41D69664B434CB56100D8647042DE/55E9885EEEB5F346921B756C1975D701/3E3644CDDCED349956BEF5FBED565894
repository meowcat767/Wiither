#include "renderer.hpp"

#include <ogc/gu.h>

#include <cmath>

namespace
{
    constexpr f32 PI = 3.14159265358979323846f;

    Color Darken(Color color, u8 amount)
    {
        return {
            static_cast<u8>(
                color.r > amount ? color.r - amount : 0
            ),
            static_cast<u8>(
                color.g > amount ? color.g - amount : 0
            ),
            static_cast<u8>(
                color.b > amount ? color.b - amount : 0
            ),
            color.a
        };
    }

    Color Lighten(Color color, u8 amount)
    {
        return {
            static_cast<u8>(
                color.r + amount > 255
                    ? 255
                    : color.r + amount
            ),
            static_cast<u8>(
                color.g + amount > 255
                    ? 255
                    : color.g + amount
            ),
            static_cast<u8>(
                color.b + amount > 255
                    ? 255
                    : color.b + amount
            ),
            color.a
        };
    }
}

Renderer::Renderer(
    GXRModeObj* videoMode,
    void** framebuffers,
    u32& framebufferIndex
)
    : m_videoMode(videoMode),
    m_framebuffers(framebuffers),
    m_framebufferIndex(framebufferIndex)
{
    SetupGX();
}

void Renderer::SetupGX()
{
    GX_ClearVtxDesc();

    GX_SetVtxDesc(
        GX_VA_POS,
        GX_DIRECT
    );

    GX_SetVtxDesc(
        GX_VA_CLR0,
        GX_DIRECT
    );

    GX_SetVtxAttrFmt(
        GX_VTXFMT0,
        GX_VA_POS,
        GX_POS_XYZ,
        GX_F32,
        0
    );

    GX_SetVtxAttrFmt(
        GX_VTXFMT0,
        GX_VA_CLR0,
        GX_CLR_RGBA,
        GX_RGBA8,
        0
    );

    GX_SetNumChans(1);

    GX_SetNumTevStages(1);

    GX_SetTevOp(
        GX_TEVSTAGE0,
        GX_PASSCLR
    );

    GX_SetTevOrder(
        GX_TEVSTAGE0,
        GX_TEXCOORDNULL,
        GX_TEXMAP_NULL,
        GX_COLOR0A0
    );

    GX_SetCullMode(GX_CULL_NONE);

    GX_SetZMode(
        GX_DISABLE,
        GX_ALWAYS,
        GX_FALSE
    );

    GX_SetColorUpdate(GX_TRUE);
    GX_SetAlphaUpdate(GX_TRUE);

    GX_SetBlendMode(
        GX_BM_BLEND,
        GX_BL_SRCALPHA,
        GX_BL_INVSRCALPHA,
        GX_LO_CLEAR
    );

    GX_SetAlphaCompare(
        GX_ALWAYS,
        0,
        GX_AOP_AND,
        GX_ALWAYS,
        0
    );
}

void Renderer::SetupProjection()
{
    Mtx44 projection;

    guOrtho(
        projection,
        0.0f,
        480.0f,
        0.0f,
        640.0f,
        0.0f,
        1.0f
    );

    GX_LoadProjectionMtx(
        projection,
        GX_ORTHOGRAPHIC
    );

    Mtx modelView;

    guMtxIdentity(modelView);

    GX_LoadPosMtxImm(
        modelView,
        GX_PNMTX0
    );

    GX_SetCurrentMtx(GX_PNMTX0);
}

void Renderer::BeginFrame()
{
    SetupProjection();

    GX_SetViewport(
        0.0f,
        0.0f,
        static_cast<f32>(m_videoMode->fbWidth),
        static_cast<f32>(m_videoMode->efbHeight),
        0.0f,
        1.0f
    );

    GX_SetScissor(
        0,
        0,
        m_videoMode->fbWidth,
        m_videoMode->efbHeight
    );
}

void Renderer::EndFrame()
{
    GX_DrawDone();

    GX_CopyDisp(
        m_framebuffers[m_framebufferIndex],
        GX_TRUE
    );

    VIDEO_SetNextFramebuffer(
        m_framebuffers[m_framebufferIndex]
    );

    VIDEO_Flush();

    VIDEO_WaitVSync();

    m_framebufferIndex ^= 1;
}

void Renderer::DrawRect(
    f32 x,
    f32 y,
    f32 width,
    f32 height,
    Color color
)
{
    GX_Begin(
        GX_QUADS,
        GX_VTXFMT0,
        4
    );

    GX_Position3f32(x, y, 0.0f);
    GX_Color4u8(color.r, color.g, color.b, color.a);

    GX_Position3f32(x + width, y, 0.0f);
    GX_Color4u8(color.r, color.g, color.b, color.a);

    GX_Position3f32(
        x + width,
        y + height,
        0.0f
    );
    GX_Color4u8(color.r, color.g, color.b, color.a);

    GX_Position3f32(x, y + height, 0.0f);
    GX_Color4u8(color.r, color.g, color.b, color.a);

    GX_End();
}


void Renderer::DrawGradientRect(
    f32 x,
    f32 y,
    f32 width,
    f32 height,
    Color topColor,
    Color bottomColor
)
{
    GX_Begin(
        GX_QUADS,
        GX_VTXFMT0,
        4
    );

    // Top-left
    GX_Position3f32(
        x,
        y,
        0.0f
    );

    GX_Color4u8(
        topColor.r,
        topColor.g,
        topColor.b,
        topColor.a
    );

    // Top-right
    GX_Position3f32(
        x + width,
        y,
        0.0f
    );

    GX_Color4u8(
        topColor.r,
        topColor.g,
        topColor.b,
        topColor.a
    );

    // Bottom-right
    GX_Position3f32(
        x + width,
        y + height,
        0.0f
    );

    GX_Color4u8(
        bottomColor.r,
        bottomColor.g,
        bottomColor.b,
        bottomColor.a
    );

    // Bottom-left
    GX_Position3f32(
        x,
        y + height,
        0.0f
    );

    GX_Color4u8(
        bottomColor.r,
        bottomColor.g,
        bottomColor.b,
        bottomColor.a
    );

    GX_End();
}

void Renderer::DrawRoundedRect(
    f32 x,
    f32 y,
    f32 width,
    f32 height,
    f32 radius,
    Color color
)
{
    // If no radius, fallback to simple rect
    if (radius <= 0.0f)
    {
        DrawRect(x, y, width, height, color);
        return;
    }

    const f32 maxRadius = (width < height ? width : height) * 0.5f;
    if (radius > maxRadius)
        radius = maxRadius;

    // Draw center and edge rectangles to form the bulk of the rounded rect
    DrawRect(
        x + radius,
        y + radius,
        width - 2.0f * radius,
        height - 2.0f * radius,
        color
    );

    // Top and bottom strips
    DrawRect(x + radius, y, width - 2.0f * radius, radius, color);
    DrawRect(x + radius, y + height - radius, width - 2.0f * radius, radius, color);

    // Left and right strips
    DrawRect(x, y + radius, radius, height - 2.0f * radius, color);
    DrawRect(x + width - radius, y + radius, radius, height - 2.0f * radius, color);

    // Corner arcs drawn as individual triangle fans to avoid a large single fan
    constexpr int SEGMENTS = 24;

    const f32 cx[4] = { x + width - radius, x + width - radius, x + radius, x + radius };
    const f32 cy[4] = { y + radius, y + height - radius, y + height - radius, y + radius };
    const f32 startAngles[4] = { 0.0f, PI * 0.5f, PI, PI * 1.5f };

    for (int corner = 0; corner < 4; ++corner)
    {
        int verts = SEGMENTS + 2; // center + perimeter points
        GX_Begin(GX_TRIANGLEFAN, GX_VTXFMT0, verts);

        // center of corner arc
        GX_Position3f32(cx[corner], cy[corner], 0.0f);
        GX_Color4u8(color.r, color.g, color.b, color.a);

        for (int s = 0; s <= SEGMENTS; ++s)
        {
            f32 angle = startAngles[corner] + (PI * 0.5f) * (static_cast<f32>(s) / SEGMENTS);
            f32 px = cx[corner] + std::cos(angle) * radius;
            f32 py = cy[corner] + std::sin(angle) * radius;

            GX_Position3f32(px, py, 0.0f);
            GX_Color4u8(color.r, color.g, color.b, color.a);
        }

        GX_End();
    }
}

void Renderer::DrawGlossyButton(
    f32 x,
    f32 y,
    f32 width,
    f32 height,
    Color color
)
{
    /*
     * 1. Soft shadow underneath.
     */
    DrawRoundedRect(
        x,
        y + 3.0f,
        width,
        height - 4.0f,
        12.0f,
        { 30, 80, 140, 100 }
    );

    /*
     * 2. Main button body (light gray).
     */
    DrawRoundedRect(
        x,
        y,
        width,
        height - 4.0f,
        12.0f,
        { 240, 240, 240, 255 }
    );

    /*
     * 3. Bright upper gloss highlight.
     */
    DrawRoundedRect(
        x + 3.0f,
        y + 3.0f,
        width - 6.0f,
        (height - 4.0f) * 0.42f,
        9.0f,
        {
            250,
            250,
            250,
            110
        }
    );

    /*
     * 4. Tiny bright rim along the top.
     */
    DrawRoundedRect(
        x + 5.0f,
        y + 4.0f,
        width - 10.0f,
        3.0f,
        2.0f,
        {
            255,
            255,
            255,
            150
        }
    );

    /*
     * 5. Slightly darker lower section.
     */
    DrawRoundedRect(
        x + 3.0f,
        y + (height - 4.0f) * 0.72f,
        width - 6.0f,
        (height - 4.0f) * 0.22f,
        7.0f,
        {
            200,
            200,
            200,
            45
        }
    );
}