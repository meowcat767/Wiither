#include "renderer.hpp"

#include <ogc/gu.h>
#include <ogc/gx.h>

Renderer::Renderer(
    GXRModeObj* videoMode,
    void** framebuffers,
    u32& framebufferIndex
)
    : m_videoMode(videoMode),
    m_framebuffers(framebuffers),
    m_framebufferIndex(framebufferIndex)
{
    SetupGX();
}

void Renderer::SetupGX()
{
    /*
     * Position data.
     */
    GX_ClearVtxDesc();

    GX_SetVtxDesc(
        GX_VA_POS,
        GX_DIRECT
    );

    GX_SetVtxDesc(
        GX_VA_CLR0,
        GX_DIRECT
    );

    /*
     * Position format.
     */
    GX_SetVtxAttrFmt(
        GX_VTXFMT0,
        GX_VA_POS,
        GX_POS_XYZ,
        GX_F32,
        0
    );

    /*
     * Colour format.
     */
    GX_SetVtxAttrFmt(
        GX_VTXFMT0,
        GX_VA_CLR0,
        GX_CLR_RGBA,
        GX_RGBA8,
        0
    );

    /*
     * We only need one colour channel.
     */
    GX_SetNumChans(1);

    /*
     * One TEV stage.
     */
    GX_SetNumTevStages(1);

    /*
     * Pass vertex colour directly to the framebuffer.
     */
    GX_SetTevOp(
        GX_TEVSTAGE0,
        GX_PASSCLR
    );

    GX_SetTevOrder(
        GX_TEVSTAGE0,
        GX_TEXCOORD_NULL,
        GX_TEXMAP_NULL,
        GX_COLOR0A0
    );

    /*
     * No back-face culling.
     */
    GX_SetCullMode(GX_CULL_NONE);

    /*
     * Disable depth testing.
     *
     * This is a 2D renderer, so draw order determines
     * what appears on top.
     */
    GX_SetZMode(
        GX_DISABLE,
        GX_ALWAYS,
        GX_FALSE
    );

    /*
     * Enable colour and alpha writes.
     */
    GX_SetColorUpdate(GX_ENABLE);
    GX_SetAlphaUpdate(GX_ENABLE);

    /*
     * Standard alpha blending.
     */
    GX_SetBlendMode(
        GX_BM_BLEND,
        GX_BL_SRCALPHA,
        GX_BL_INVSRCALPHA,
        GX_LO_CLEAR
    );

    /*
     * Allow all alpha values.
     */
    GX_SetAlphaCompare(
        GX_ALWAYS,
        0,
        GX_AOP_AND,
        GX_ALWAYS,
        0
    );
}

void Renderer::SetupProjection()
{
    Mtx projection;

    /*
     * Our logical UI resolution.
     *
     * Everything will be designed around 640x480.
     */
    guOrtho(
        projection,
        0.0f,
        480.0f,
        0.0f,
        640.0f,
        0.0f,
        1.0f
    );

    GX_LoadProjectionMtx(
        projection,
        GX_ORTHOGRAPHIC
    );

    /*
     * Identity model-view matrix.
     */
    Mtx modelView;

    guMtxIdentity(modelView);

    GX_LoadPosMtxImm(
        modelView,
        GX_PNMTX0
    );
}

void Renderer::BeginFrame()
{
    /*
     * Configure our 2D projection.
     */
    SetupProjection();

    /*
     * Set the viewport to the actual Wii framebuffer.
     */
    GX_SetViewport(
        0.0f,
        0.0f,
        static_cast<f32>(m_videoMode->fbWidth),
        static_cast<f32>(m_videoMode->efbHeight),
        0.0f,
        1.0f
    );

    GX_SetScissor(
        0,
        0,
        m_videoMode->fbWidth,
        m_videoMode->efbHeight
    );
}

void Renderer::EndFrame()
{
    /*
     * Finish all submitted GX commands.
     */
    GX_DrawDone();

    /*
     * Copy the EFB to the current external framebuffer.
     */
    GX_CopyDisp(
        m_framebuffers[m_framebufferIndex],
        GX_TRUE
    );

    VIDEO_SetNextFramebuffer(
        m_framebuffers[m_framebufferIndex]
    );

    VIDEO_Flush();

    /*
     * Wait for the display refresh.
     */
    VIDEO_WaitVSync();

    /*
     * Switch to the other framebuffer.
     */
    m_framebufferIndex ^= 1;
}

void Renderer::DrawRect(
    f32 x,
    f32 y,
    f32 width,
    f32 height,
    Color color
)
{
    const f32 x2 = x + width;
    const f32 y2 = y + height;

    GX_Begin(
        GX_QUADS,
        GX_VTXFMT0,
        4
    );

    GX_Position3f32(
        x,
        y,
        0.0f
    );

    GX_Color4u8(
        color.r,
        color.g,
        color.b,
        color.a
    );

    GX_Position3f32(
        x2,
        y,
        0.0f
    );

    GX_Color4u8(
        color.r,
        color.g,
        color.b,
        color.a
    );

    GX_Position3f32(
        x2,
        y2,
        0.0f
    );

    GX_Color4u8(
        color.r,
        color.g,
        color.b,
        color.a
    );

    GX_Position3f32(
        x,
        y2,
        0.0f
    );

    GX_Color4u8(
        color.r,
        color.g,
        color.b,
        color.a
    );

    GX_End();
}